{
  "compilerOptions": {
    // Compilation
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020"],

    // Dossiers
    "rootDir": "./src",
    "outDir": "./dist",

    // Résolution des modules
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,

    // Strictness (recommandé)
    "strict": true,
    "noImplicitAny": true,
    "noImplicitReturns": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,

    // Debugging
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,

    // Performance
    "skipLibCheck": true
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "**/*.test.ts"]
}
